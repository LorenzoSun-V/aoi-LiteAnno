#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LITEANNO_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LITEANNO_BUILD_NUMBER@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            @LITEANNO_RC_COMPANY_LINE@
            VALUE "FileDescription", "@LITEANNO_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@.@LITEANNO_BUILD_NUMBER@"
            VALUE "InternalName", "@LITEANNO_RC_FILE_NAME@"
            VALUE "OriginalFilename", "@LITEANNO_RC_FILE_NAME@"
            VALUE "ProductName", "aoi-LiteAnno"
            VALUE "ProductVersion", "@PROJECT_VERSION@.@LITEANNO_BUILD_NUMBER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
