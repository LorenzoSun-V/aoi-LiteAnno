# Module dependency rules (architecture section 13), checked at configure time.

# Collects every target and library a target links to, directly or transitively.
function(_liteanno_link_closure target out_var)
    set(_seen "")
    set(_queue "${target}")
    while(_queue)
        list(POP_FRONT _queue _current)
        if(_current IN_LIST _seen)
            continue()
        endif()
        list(APPEND _seen "${_current}")
        if(NOT TARGET "${_current}")
            continue()
        endif()

        get_target_property(_aliased "${_current}" ALIASED_TARGET)
        if(_aliased)
            list(APPEND _queue "${_aliased}")
            continue()
        endif()

        get_target_property(_type "${_current}" TYPE)
        set(_properties INTERFACE_LINK_LIBRARIES)
        if(NOT _type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND _properties LINK_LIBRARIES)
        endif()
        foreach(_property IN LISTS _properties)
            get_target_property(_libraries "${_current}" ${_property})
            if(NOT _libraries)
                continue()
            endif()
            foreach(_library IN LISTS _libraries)
                # Static libraries list their private dependencies as $<LINK_ONLY:...>.
                string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" _library "${_library}")
                if(NOT _library MATCHES "^\\$<")
                    list(APPEND _queue "${_library}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    set(${out_var} "${_seen}" PARENT_SCOPE)
endfunction()

# liteanno_forbid_dependencies(<target> FORBIDDEN <target>...)
# Fails the configuration when <target> links to any of the forbidden targets.
function(liteanno_forbid_dependencies target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "FORBIDDEN")
    _liteanno_link_closure("${target}" _closure)
    foreach(_forbidden IN LISTS ARG_FORBIDDEN)
        if(_forbidden IN_LIST _closure)
            message(FATAL_ERROR
                "Dependency rule violated: ${target} must not depend on ${_forbidden} (architecture section 13).")
        endif()
    endforeach()
endfunction()
